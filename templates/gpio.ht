// Example HGLETL template (Mustache-like). Adapt placeholder syntax to your HGLETL if needed.
Peripheral: {{peripheral.name}} (base {{peripheral.baseAddress}})

{{#registers}}
/* Register: {{name}} (offset {{addressOffset}}) */
#define {{name}}_OFFSET {{addressOffset}}
{{#fields}}
/* Field: {{name}} pos={{bitOffset}} width={{bitWidth}} */
#define {{name}}_{{.}}_POS {{bitOffset}}
#define {{name}}_{{.}}_MASK ( ((1u<<{{bitWidth}})-1u) << {{bitOffset}} )
{{/fields}}

{{/registers}}
